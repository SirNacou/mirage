// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"customizations": {
		"vscode": {
			"extensions": [
				"cweijan.vscode-postgresql-client2",
				"redhat.vscode-yaml"
			]
		}
	},
	"dockerComposeFile": "docker-compose.yml",
	"features": {
		"ghcr.io/devcontainers-extra/features/bun:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
			"moby": "false",
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "lts"
		},
		"ghcr.io/eitsupi/devcontainer-features/go-task:1": {},
		"ghcr.io/nlstn/devcontainer-features/go-air:1": {},
		"ghcr.io/rafaph/devcontainer-features/goose-cli:1": {}
	},
	"forwardPorts": [
		4224,
		5432,
		8080
	],
	"mounts": [
		// Mount host socket to a neutral temporary directory to prevent Docker from altering ~/.gnupg ownership
		"source=/run/user/1000/gnupg/S.gpg-agent,target=/tmp/host-gpg/S.gpg-agent,type=bind"
	],
	"name": "Mirage",
	// Setup clean ~/.gnupg workspace directory and symlink the host agent socket
	"postStartCommand": "mkdir -p /home/vscode/.gnupg && chmod 700 /home/vscode/.gnupg && ln -sf /tmp/host-gpg/S.gpg-agent /home/vscode/.gnupg/S.gpg-agent",
	"service": "devcontainer",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}